generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 관리자 접속(로그인) 로그 — 마스터(전체 관리자)만 조회
model AccessLog {
  id        String   @id @default(cuid())
  username  String
  role      String   @default("")
  action    String   @default("login") // login | login_fail
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 사이트 전역 설정(키-값) — 예: 상세 페이지 공통 상단 배너
model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Clinic {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  region    String
  address   String
  phone     String
  intro     String   @default("")
  tags      String   @default("[]") // JSON array
  hours     String   @default("{}") // JSON object
  transport String   @default("")
  parking   String   @default("")
  mapUrl     String   @default("")
  websiteUrl String   @default("") // 지점 공식 홈페이지 URL
  blogUrl    String   @default("") // 지점 블로그 URL
  sortOrder  Int      @default(0)  // 지점 안내 노출 정렬 순서 (작을수록 먼저)
  lat        Float?
  lng        Float?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  doctors    Doctor[]
  images     ClinicImage[]
  adminUsers AdminUser[]
}

model Doctor {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  title       String   @default("")
  specialties String   @default("[]") // JSON array
  bio         String   @default("")
  photoUrl    String   @default("")
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model ClinicImage {
  id        String   @id @default(cuid())
  clinicId  String
  url       String
  type      String   @default("GALLERY") // "HERO" | "GALLERY"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         String    @default("CLINIC_ADMIN") // "SUPER_ADMIN" | "CLINIC_ADMIN"
  clinicId     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
}
